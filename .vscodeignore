.vscode/**
.vscode-test/**
src/**
.git/**
.gitignore
.agent-mesh-task.json
tsconfig.json
**/*.map
out/test/**
out/review-*.log

# The build output is gitignored; whitelist runtime JavaScript without reviving test and log artifacts.
!out/extension.js
!out/bridge/**/*.js
!out/config/**/*.js
!out/ui/**/*.js

# Development-only material: never needed at runtime, would only bloat the .vsix.
AGENTS.md
DESIGN.md
docs/**
eslint.config.mjs
.prettierrc
.prettierignore
*.vsix

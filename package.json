{
  "name": "agent-mesh-bridge",
  "displayName": "Agent Mesh Bridge",
  "description": "Peer-to-Peer Multi-Agent Bridge connecting Google Antigravity, OpenAI Codex, Anthropic Claude Code, and DeepSeek Harness in VSCode",
  "version": "1.0.0",
  "publisher": "agent-mesh",
  "author": "Antigravity Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agent-mesh/agent-mesh-bridge"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Tools"
  ],
  "keywords": [
    "agent",
    "mesh",
    "antigravity",
    "codex",
    "claude",
    "deepseek",
    "dsh",
    "mcp",
    "multi-agent"
  ],
  "main": "./out/extension.js",
  "bin": {
    "agent-bridge-mcp": "./bin/agent-bridge-mcp.cjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-mesh-bridge-container",
          "title": "Agent Mesh Bridge",
          "icon": "resources/bridge-icon.svg"
        }
      ]
    },
    "views": {
      "agent-mesh-bridge-container": [
        {
          "id": "agent-mesh-bridge.agent-nodes",
          "name": "Agent Nodes / 节点状态"
        },
        {
          "id": "agent-mesh-bridge.active-tasks",
          "name": "Active & In-Review Tasks"
        },
        {
          "id": "agent-mesh-bridge.recent-tasks",
          "name": "Recent Tasks (1,000 Ledger)"
        }
      ]
    },
    "commands": [
      {
        "command": "agent-mesh-bridge.refreshAgentStatus",
        "title": "Refresh Agent Nodes Status",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-mesh-bridge.clearAgentExhaustion",
        "title": "Clear Agent Rate Limit Status"
      },
      {
        "command": "agent-mesh-bridge.refreshTasks",
        "title": "Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-mesh-bridge.selectActiveAgent",
        "title": "Agent Bridge: Switch Active Agent"
      },
      {
        "command": "agent-mesh-bridge.openTaskDetail",
        "title": "Open Task Details"
      },
      {
        "command": "agent-mesh-bridge.approveTask",
        "title": "Approve Task"
      },
      {
        "command": "agent-mesh-bridge.requestRework",
        "title": "Request Rework"
      },
      {
        "command": "agent-mesh-bridge.resumeTask",
        "title": "Resume / Continue Task",
        "icon": "$(play)"
      },
      {
        "command": "agent-mesh-bridge.pauseTask",
        "title": "Pause Task / 暂停任务",
        "icon": "$(debug-pause)"
      },
      {
        "command": "agent-mesh-bridge.deleteTask",
        "title": "Delete Task / 删除任务",
        "icon": "$(trash)"
      },
      {
        "command": "agent-mesh-bridge.wakeUpCaller",
        "title": "Wake Up Initiator / 唤醒下发者检视",
        "icon": "$(bell)"
      },
      {
        "command": "agent-mesh-bridge.syncMcpConfig",
        "title": "Sync MCP Configuration to Agents"
      },
      {
        "command": "agent-mesh-bridge.configureDeepSeekHarness",
        "title": "Configure DeepSeek Harness Model Route"
      },
      {
        "command": "agent-mesh-bridge.printRecentLogs",
        "title": "Print Recent 1,000 Lines / 打印最近1000行日志",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-mesh-bridge.refreshAgentStatus",
          "when": "view == agent-mesh-bridge.agent-nodes",
          "group": "navigation"
        },
        {
          "command": "agent-mesh-bridge.refreshTasks",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.recent-tasks",
          "group": "navigation"
        },
        {
          "command": "agent-mesh-bridge.syncMcpConfig",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.agent-nodes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "agent-mesh-bridge.clearAgentExhaustion",
          "when": "view == agent-mesh-bridge.agent-nodes",
          "group": "1_actions"
        },
        {
          "command": "agent-mesh-bridge.openTaskDetail",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.recent-tasks",
          "group": "inline"
        },
        {
          "command": "agent-mesh-bridge.printRecentLogs",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.recent-tasks",
          "group": "inline"
        },
        {
          "command": "agent-mesh-bridge.approveTask",
          "when": "view == agent-mesh-bridge.active-tasks",
          "group": "1_actions"
        },
        {
          "command": "agent-mesh-bridge.requestRework",
          "when": "view == agent-mesh-bridge.active-tasks",
          "group": "1_actions"
        },
        {
          "command": "agent-mesh-bridge.resumeTask",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.recent-tasks",
          "group": "1_actions"
        },
        {
          "command": "agent-mesh-bridge.pauseTask",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.recent-tasks",
          "group": "1_actions"
        },
        {
          "command": "agent-mesh-bridge.deleteTask",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.recent-tasks",
          "group": "1_actions"
        },
        {
          "command": "agent-mesh-bridge.wakeUpCaller",
          "when": "view == agent-mesh-bridge.active-tasks || view == agent-mesh-bridge.recent-tasks",
          "group": "1_actions"
        }
      ]
    },
    "configuration": {
      "title": "Agent Mesh Bridge",
      "properties": {
        "agentMeshBridge.defaultAgent": {
          "type": "string",
          "enum": [
            "auto",
            "codex",
            "claude_code",
            "antigravity",
            "deepseek_harness"
          ],
          "default": "auto",
          "description": "Default target agent for task delegation when not explicitly specified."
        },
        "agentMeshBridge.maxTasks": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of tasks stored in the persistent delegation ledger."
        },
        "agentMeshBridge.taskTimeoutMinutes": {
          "type": "number",
          "default": 120,
          "description": "Maximum execution timeout in minutes for a single task round before terminating (default: 120 mins / 2 hours)."
        },
        "agentMeshBridge.antigravityPath": {
          "type": "string",
          "default": "",
          "description": "Custom executable path for Google Antigravity (agy)."
        },
        "agentMeshBridge.claudeCodePath": {
          "type": "string",
          "default": "",
          "description": "Custom executable path for Anthropic Claude Code (claude)."
        },
        "agentMeshBridge.codexPath": {
          "type": "string",
          "default": "",
          "description": "Custom executable path for OpenAI Codex (codex)."
        },
        "agentMeshBridge.deepseekHarnessPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the DeepSeek Harness CLI launcher (dsh.cmd / dsh). Leave empty to auto-detect the installation."
        },
        "agentMeshBridge.deepseekHarness.provider": {
          "type": "string",
          "default": "",
          "description": "Model provider written into the DeepSeek Harness 'headless' profile for bridge-launched runs (e.g. \"commandcode\"). Leave empty to keep DSH's shipped deepseek-official route."
        },
        "agentMeshBridge.deepseekHarness.api": {
          "type": "string",
          "default": "openai-completions",
          "enum": [
            "openai-completions",
            "anthropic-messages"
          ],
          "description": "Wire protocol used by the configured DeepSeek Harness provider."
        },
        "agentMeshBridge.deepseekHarness.baseUrl": {
          "type": "string",
          "default": "https://api.commandcode.ai/provider/v1",
          "description": "Base URL of the configured DeepSeek Harness provider."
        },
        "agentMeshBridge.deepseekHarness.model": {
          "type": "string",
          "default": "deepseek/deepseek-v4.1-flash",
          "description": "Model id made the default for bridge-launched DeepSeek Harness runs."
        },
        "agentMeshBridge.deepseekHarness.apiKeyEnv": {
          "type": "string",
          "default": "COMMANDCODE_API_KEY",
          "description": "Environment variable the DeepSeek Harness provider reads its API key from. The extension exports this variable to the DSH process it launches."
        },
        "agentMeshBridge.deepseekHarness.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "API key for the configured DeepSeek Harness provider. Exported to the launched DSH process through `#agentMeshBridge.deepseekHarness.apiKeyEnv#`. Kept in machine-scope settings so it is never synced; leave empty to supply the key through the environment variable instead."
        },
        "agentMeshBridge.autoSyncMcp": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync MCP configuration to Antigravity, Claude, Codex, and DeepSeek Harness profiles on activation."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --test out/test/**/*.test.js",
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.29.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.2"
  }
}
